{
  "name": "etsv-lauda-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:https": "next dev --turbopack --experimental-https",
    "build": "next build",
    "start": "next start",
    "ci": "pnpm payload migrate && pnpm build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "payload:generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "payload:generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate": "cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "seed:admin": "node --env-file=.env --import=tsx/esm scripts/seed-admin.ts",
    "seed:baseline": "node --env-file=.env --import=tsx/esm scripts/seed-baseline.ts",
    "seed:demo": "node --env-file=.env --import=tsx/esm scripts/seed-demo.ts",
    "posts:generate": "node --env-file=.env --import=tsx/esm scripts/generate-matchday-posts.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "^3.87.0",
    "@payloadcms/live-preview-react": "^3.87.0",
    "@payloadcms/next": "^3.87.0",
    "@payloadcms/plugin-redirects": "^3.87.0",
    "@payloadcms/plugin-seo": "^3.87.0",
    "@payloadcms/richtext-lexical": "^3.87.0",
    "@payloadcms/storage-vercel-blob": "^3.87.0",
    "@tailwindcss/typography": "^0.5.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.4.3",
    "payload": "^3.87.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@payloadcms/typescript-plugin": "^3.87.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.20.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
