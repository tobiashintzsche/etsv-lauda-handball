# ─── Datenbank ───────────────────────────────────────────────────────────────
# Variante A (empfohlen): Docker — `docker compose up -d` startet Postgres 17
# auf Port 5502 (bewusst nicht 5432, um Konflikte mit lokalen Installationen
# zu vermeiden).
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5502/etsv_lauda
#
# Variante B: lokal installiertes Postgres (z.B. Homebrew) auf Port 5432.
#   createdb etsv_lauda
DATABASE_URL=postgresql://postgres:postgres@localhost:5502/etsv_lauda

# ─── Payload ─────────────────────────────────────────────────────────────────
# Signiert Auth-Cookies und Preview-Tokens. Neu erzeugen mit:
#   openssl rand -hex 32
PAYLOAD_SECRET=change-me

# ─── URLs ────────────────────────────────────────────────────────────────────
# Basis-URL der Seite. Lokal http://localhost:3000, in Produktion die Live-Domain.
# Wird fuer metadataBase, Canonicals, Sitemap und Live-Preview genutzt.
#
# WICHTIG: `NEXT_PUBLIC_*` wird zur BUILDZEIT in den Client-Bundle inlined, nicht
# zur Laufzeit gelesen. Die Variable muss deshalb im Vercel-Projekt fuer ALLE
# Environments (Production, Preview, Development) gesetzt sein — sonst zeigt die
# Live-Preview-Bruecke in Produktion auf localhost. Nach einer Aenderung ist ein
# neuer Build noetig, ein Redeploy des alten Builds reicht nicht.
# Ist sie nicht gesetzt, faellt der Server auf VERCEL_PROJECT_PRODUCTION_URL bzw.
# VERCEL_URL zurueck (lib/env.ts); im Client bleibt die Live-Preview dann aus.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ─── Vercel Blob (optional) ──────────────────────────────────────────────────
# Ohne Token schreibt Payload Uploads ins lokale Dateisystem (./media).
# Mit Token laufen sie ueber den Vercel Blob Store.
# BLOB_READ_WRITE_TOKEN=
